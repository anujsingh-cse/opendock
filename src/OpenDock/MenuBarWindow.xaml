<Window x:Class="OpenDock.MenuBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenDock Menu Bar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#B324242A"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        Height="30">
    <Grid>
    <DockPanel Margin="12,0,12,0">
        <!-- Left: OpenDock menu + active app name -->
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="MenuButton" Content="&#x25CF;" FontSize="14" Foreground="White"
                    Background="Transparent" BorderThickness="0" Padding="8,2"
                    Cursor="Hand" Click="OnMenuClick"/>
            <TextBlock x:Name="AppNameText" Text="OpenDock" Foreground="White" FontSize="13"
                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>
        </StackPanel>

        <!-- Right: Spotlight, Control Center, clock, show-desktop -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="SpotlightButton" Content="&#x2315;" FontSize="14" Foreground="White"
                    Background="Transparent" BorderThickness="0" Padding="8,2"
                    Cursor="Hand" ToolTip="Spotlight search" Click="OnSpotlightClick"/>
            <Button x:Name="ControlCenterButton" Content="&#x25C9;" FontSize="14" Foreground="White"
                    Background="Transparent" BorderThickness="0" Padding="8,2"
                    Cursor="Hand" ToolTip="Control Center" Click="OnControlCenterClick"/>
            <TextBlock x:Name="ClockText" Foreground="White" FontSize="13"
                       VerticalAlignment="Center" Margin="8,0"/>
            <Button x:Name="ShowDesktopButton" Content="&#x25AD;" FontSize="13" Foreground="White"
                    Background="Transparent" BorderThickness="0" Padding="8,2"
                    Cursor="Hand" ToolTip="Show desktop" Click="OnShowDesktopClick"/>
        </StackPanel>
    </DockPanel>

    <!-- Control Center panel -->
    <Popup x:Name="ControlCenterPopup" StaysOpen="False" Placement="Bottom"
           PlacementTarget="{Binding ElementName=ControlCenterButton}">
        <Border CornerRadius="12" BorderThickness="1" Padding="14" Width="260"
                Background="#F22B2B31" BorderBrush="#40FFFFFF">
            <StackPanel>
                <TextBlock Text="Control Center" Foreground="White" FontWeight="SemiBold"
                           FontSize="14" Margin="0,0,0,10"/>

                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Wi-Fi" Foreground="White" VerticalAlignment="Center"
                               DockPanel.Dock="Left"/>
                    <Button Content="Settings" DockPanel.Dock="Right" Padding="8,2"
                            Click="OnWifiSettings"/>
                </DockPanel>
                <TextBlock x:Name="WifiNote" Foreground="#AAFFFFFF" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="Toggle Wi-Fi from Windows Settings."/>

                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Bluetooth" Foreground="White" VerticalAlignment="Center"
                               DockPanel.Dock="Left"/>
                    <Button Content="Settings" DockPanel.Dock="Right" Padding="8,2"
                            Click="OnBluetoothSettings"/>
                </DockPanel>
                <TextBlock Foreground="#AAFFFFFF" FontSize="11" TextWrapping="Wrap"
                           Margin="0,0,0,10"
                           Text="Toggle Bluetooth from Windows Settings."/>

                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Volume" Foreground="White" VerticalAlignment="Center"
                               DockPanel.Dock="Left"/>
                    <Button x:Name="MuteButton" Content="Mute" DockPanel.Dock="Right"
                            Padding="8,2" Click="OnMuteClick"/>
                </DockPanel>
                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100"
                        Margin="0,0,0,10" ValueChanged="OnVolumeChanged"/>

                <TextBlock Text="Display brightness" Foreground="White" Margin="0,0,0,4"/>
                <TextBlock Foreground="#AAFFFFFF" FontSize="11" TextWrapping="Wrap"
                           Text="Brightness isn't adjustable from here — use Windows Quick Settings (Win+A)."/>
            </StackPanel>
        </Border>
    </Popup>
    </Grid>
</Window>
