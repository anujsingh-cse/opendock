<Window x:Class="OpenDock.LaunchpadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Launchpad"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#D81A1A20"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <!-- Pages and tiles are built from code-behind; XAML holds the chrome:
         search box on top, page host in the middle, page dots at the bottom. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,48,0,0">
            <Button x:Name="BackButton" Content="‹ All Apps" Visibility="Collapsed"
                    Margin="0,0,12,0" Padding="10,4" Click="OnBackClick"/>
            <TextBox x:Name="SearchBox" Width="340" FontSize="15" Padding="10,6"
                     VerticalContentAlignment="Center"
                     TextChanged="OnSearchChanged"/>
        </StackPanel>

        <Grid x:Name="PageHost" Grid.Row="1" Margin="80,24"/>

        <StackPanel x:Name="DotsPanel" Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,0,0,48"/>
    </Grid>
</Window>
